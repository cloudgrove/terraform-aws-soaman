GITHUB_ORG=cloudgrove
DOCKER_IMAGE_PREFIX=cloudgrove/
DOCKER_PROJECT_DIR=/data/project
DOCKER_ARTIFACT_SUBDIR=src
DOCKER_ARTIFACT_EXPORT=false
DOCKER_BUILD_ARGS="DOCKER_PROJECT_DIR DOCKER_ARTIFACT_SUBDIR AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY"
BUILD_SCRIPTS_GITHUB_ORG=cloudgrove
BUILD_SCRIPTS_REPO_NAME=automation-scripts
BUILD_SCRIPTS_REPO_TAG=1.2.0
PROJECT_TYPE=terraform/lib
SET_TF_WORKSPACE=true
